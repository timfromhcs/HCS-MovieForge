# Git ignore file for HCS MovieForge

# Secrets and environment variables - CRITICAL: NEVER COMMIT SECRETS
.env
.env.*
!.env.example
secrets/
*.token
*.key
*.pem
*.secret
credentials.json

# Local runtime directories & files
runtime/
cache/
logs/
dist/
build/
bin/

# Local projects data (except .gitkeep)
projects/*
!projects/.gitkeep

# Model weights and binaries (never commit local model stores to Git)
models/*
!models/manifests/
!models/manifests/**
!models/locks/
!models/locks/**
!models/README.md
models/**/*.gguf
models/**/*.safetensors
models/**/*.bin
models/**/*.pt
models/**/*.onnx
models/**/*.ckpt
models/staging/
models/downloads/
models/cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/
.ruff_cache/

# Node / Web / Desktop UI
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
apps/desktop/dist/
apps/desktop/build/
packages/*/dist/
.eslintcache

# Rust / Tauri
target/
Cargo.lock
**/*.rs.bk
apps/desktop/src-tauri/target/

# C / C++ / CMake build outputs
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.ninja
.ninja_*
compile_commands.json

# Blender temporary files
*.blend1
*.blend2
*.blend@
*.swp
*.crash

# OS specific files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Visual verification & test outputs
artifacts/verification/*/visual/
tests/fixtures/tmp/
tests/stress/logs/
