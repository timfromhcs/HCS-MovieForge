# HCS MovieForge Environment Configuration Template
# Copy this file to .env and fill in your values. NEVER commit .env to version control!

# GitHub Credentials (optional, for release automation and issue tracking)
GITHUB_USER=
GITHUB_TOKEN=

# Hugging Face Credentials (for authenticated model downloads and HF Space sync)
HF_TOKEN=

# Git Author Config (if not configured globally)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# Local Runtime Directories (defaults to relative project directories)
MOVIEFORGE_DATA_DIR=runtime
MOVIEFORGE_MODELS_DIR=models
MOVIEFORGE_CACHE_DIR=cache
MOVIEFORGE_PROJECTS_DIR=projects

# Hardware & Vulkan settings
MOVIEFORGE_VULKAN_DEVICE=0
MOVIEFORGE_LOG_LEVEL=INFO
